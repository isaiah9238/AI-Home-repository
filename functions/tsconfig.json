{
  "compilerOptions": {
    "module": "commonjs",
    "noImplicitReturns": true,
    "sourceMap": true,
    "target": "es2022",
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "*": ["./*"]
    }
  }
}